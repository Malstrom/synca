#!/usr/bin/env bash
# bin/sync — rebase sul remoto, poi pusha ciò che hai già staged
# Usage: git add <files> && bin/sync "feat(auth): add JwtService"
set -euo pipefail

MSG="${1:-}"
[[ -z "$MSG" ]] && { echo "Usage: bin/sync \"commit message\""; exit 1; }

# 1. Controlla se c'è qualcosa di staged
git diff --cached --quiet && { echo "Nothing staged. Run 'git add <files>' first."; exit 1; }

# 2. Stash solo l'unstaged (mantiene lo staged intatto)
git stash push --keep-index -m "sync-unstaged-$(date +%s)" 2>/dev/null || true

# 3. Pull rebase
git pull --rebase origin "$(git branch --show-current)"

# 4. Commit e push
git commit -m "$MSG"
git push origin "$(git branch --show-current)"

# 5. Ripristina eventuale stash
git stash pop 2>/dev/null || true

echo "✓ Done"