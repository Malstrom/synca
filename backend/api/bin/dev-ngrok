#!/usr/bin/env bash
# Starts Rails + Caddy (api.synca.local) + ngrok (public URL for device/webhooks).
# Writes ngrok URL to .env.ngrok, destroys it on exit.
# Usage: bin/dev-ngrok
#
# First run only — add local domain to /etc/hosts (requires sudo):
#   sudo bash -c 'echo "127.0.0.1 api.synca.local" >> /etc/hosts'

set -e

REPO_ROOT="$(cd "$(dirname "$0")/../../../" && pwd)"
ENV_FILE="$REPO_ROOT/.env.ngrok"
CADDYFILE="/tmp/Caddyfile-synca"

cleanup() {
  echo ""
  echo "🛑 Shutting down..."
  kill "$RAILS_PID" 2>/dev/null || true
  kill "$NGROK_PID" 2>/dev/null || true
  kill "$CADDY_PID" 2>/dev/null || true
  # Destroy .env.ngrok so the stale URL never persists
  rm -f "$ENV_FILE"
  rm -f "$CADDYFILE"
  echo "🗑  .env.ngrok destroyed."
  echo "👋 Done."
  exit 0
}
trap cleanup INT TERM

# ── Dependency checks ────────────────────────────────────────────────────────
for cmd in ngrok caddy ruby curl; do
  if ! command -v "$cmd" &>/dev/null; then
    echo "❌ '$cmd' not found."
    case $cmd in
      ngrok)  echo "   Install: brew install ngrok" ;;
      caddy)  echo "   Install: brew install caddy" ;;
      ruby)   echo "   Install: rbenv or asdf" ;;
    esac
    exit 1
  fi
done

# ── Check /etc/hosts ────────────────────────────────────────────────────────
if ! grep -q "api.synca.local" /etc/hosts; then
  echo ""
  echo "⚠️  'api.synca.local' not found in /etc/hosts."
  echo "   Run this once to add it (requires sudo):"
  echo ""
  echo "   sudo bash -c 'echo \"127.0.0.1 api.synca.local\" >> /etc/hosts'"
  echo ""
  echo "   Then re-run bin/dev-ngrok."
  exit 1
fi

# ── Start Rails ─────────────────────────────────────────────────────────────
echo "🚀 Starting Rails on port 3000..."
bin/rails s -p 3000 -b 127.0.0.1 &
RAILS_PID=$!

echo "⏳ Waiting for Rails to boot..."
for i in $(seq 1 20); do
  STATUS=$(curl -s -o /dev/null -w "%{http_code}" http://127.0.0.1:3000/up 2>/dev/null || true)
  if [ "$STATUS" = "200" ]; then
    echo "✅ Rails is up."
    break
  fi
  sleep 1
done

# ── Start Caddy (local domain proxy) ────────────────────────────────────────
# Writes a minimal Caddyfile that proxies api.synca.local → localhost:3000
cat > "$CADDYFILE" <<EOF
http://api.synca.local {
  reverse_proxy 127.0.0.1:3000
}
EOF

echo "🌐 Starting Caddy (http://api.synca.local → :3000)..."
caddy run --config "$CADDYFILE" > /tmp/caddy-synca.log 2>&1 &
CADDY_PID=$!
sleep 1

# ── Start ngrok (public URL for device / webhooks) ──────────────────────────
echo "🌍 Starting ngrok tunnel..."
ngrok http 3000 --log=stdout --log-level=warn > /tmp/ngrok-synca.log 2>&1 &
NGROK_PID=$!

echo "⏳ Waiting for ngrok tunnel..."
NGROK_URL=""
for i in $(seq 1 15); do
  NGROK_URL=$(curl -s http://127.0.0.1:4040/api/tunnels 2>/dev/null \
    | ruby -rjson -e '
        data = JSON.parse($stdin.read) rescue {}
        tunnels = data["tunnels"] || []
        t = tunnels.find { |t| t["proto"] == "https" }
        puts t["public_url"] if t
      ' 2>/dev/null || true)
  [ -n "$NGROK_URL" ] && break
  sleep 1
done

if [ -z "$NGROK_URL" ]; then
  echo "❌ Could not get ngrok URL. Check /tmp/ngrok-synca.log"
  cleanup
fi

# Write ngrok URL — will be destroyed on exit
echo "BASE_URL=$NGROK_URL" > "$ENV_FILE"

# ── Summary ──────────────────────────────────────────────────────────────────
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  🏠 Local:     http://api.synca.local   (Simulator)"
echo "  🌍 Public:    $NGROK_URL"
echo "  📖 API docs:  http://api.synca.local/api-docs"
echo "  📝 .env.ngrok written (auto-deleted on exit)"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "Press Ctrl+C to stop everything and clean up."

wait $RAILS_PID
