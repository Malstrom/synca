# Rails
RAILS_MASTER_KEY=
SECRET_KEY_BASE=
RAILS_ENV=development

# Database
DATABASE_URL=postgres://synca:password@localhost:5432/synca_development

# JWT (generated with: openssl rand -hex 64)
JWT_SECRET_KEY=

# --- Yandex Object Storage (backups) ---
# Create a service account in Yandex Cloud IAM with storage.uploader role
# then generate a static access key.
YC_ACCESS_KEY_ID=
YC_SECRET_ACCESS_KEY=
YC_BACKUP_BUCKET=synca-backups

# --- Yandex Cloud Logging ---
# Folder ID visible in Yandex Cloud Console > Overview
YC_FOLDER_ID=

# --- GlitchTip error tracking (self-hosted) ---
# After deploying GlitchTip accessory, create a project and copy the DSN.
SENTRY_DSN=
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DATABASE_URL=

# --- Active Storage (photo uploads) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
