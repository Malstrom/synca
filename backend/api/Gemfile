# frozen_string_literal: true

source "https://rubygems.org"

# ─── Core ─────────────────────────────────────────────

gem "rails", "~> 8.0.3"

# PostgreSQL adapter
gem "pg", "~> 1.1"

# Puma web server
gem "puma", ">= 5.0"

# Reduces boot times through caching
gem "bootsnap", require: false

# Windows timezone support
gem "tzinfo-data", platforms: %i[ windows jruby ]

# ─── API ──────────────────────────────────────────────

# Handle Cross-Origin requests from iOS/Android clients
gem "rack-cors"

# Lightweight pagination for API endpoints
gem "pagy"

# ─── Auth ─────────────────────────────────────────────

# Password hashing for has_secure_password
gem "bcrypt", "~> 3.1.7"

# JWT-based authentication via Devise
gem "devise"
gem "devise-jwt"

# ─── Background Jobs, Cache & WebSocket ───────────────

# DB-backed cache store (replaces Redis for caching)
gem "solid_cache"

# DB-backed background job queue (replaces Sidekiq)
gem "solid_queue"

# DB-backed Action Cable adapter (replaces Redis pub/sub)
gem "solid_cable"

# ─── Storage ──────────────────────────────────────────

# Image processing for profile photo variants
gem "image_processing", "~> 1.2"

# AWS S3 for profile photo storage
gem "aws-sdk-s3", require: false

# ─── Business Logic ───────────────────────────────────

# Role-based authorization (users can only modify their own resources)
gem "pundit"

# Clean service objects for matching and scoring logic
gem "interactor"

# ─── Development ──────────────────────────────────────
group :development do
  # Annotates models with DB schema info as comments
  gem "annotate"

  # Debugging
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"

  # Security vulnerability static analysis
  gem "brakeman", require: false

  # CVE audit for gem dependencies
  gem "bundler-audit", require: false
end

# ─── Development & Test ───────────────────────────────
group :development, :test do
  # RuboCop with Rails cops for code style enforcement (includes rubocop-rails)
  gem "rubocop-rails-omakase", require: false

  # Test factories for Minitest
  gem "factory_bot_rails"

  # Fake data generator for seeds and tests
  gem "faker"
end

# ─── Test ─────────────────────────────────────────────
group :test do
  # Code coverage reporting
  gem "simplecov", require: false

  # Cleans database between Minitest runs
  gem "database_cleaner-active_record"

  # HTTP request mocking in tests
  gem "webmock"
end
