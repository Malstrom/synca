# Secrets pulled from environment (set in GitHub Actions or local shell).
# DO NOT put raw values here — this file is committed to git.
#
# App-level secrets (jwt_secret_key, etc.) are stored in
# config/credentials.yml.enc and unlocked by RAILS_MASTER_KEY — not listed here.

# --- Infrastructure secrets (GitHub Actions Secrets) ---
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
KAMAL_SERVER_IP=$KAMAL_SERVER_IP
KAMAL_SERVER_HOST=$KAMAL_SERVER_HOST

# --- Rails secrets ---
RAILS_MASTER_KEY=$RAILS_MASTER_KEY
SECRET_KEY_BASE=$SECRET_KEY_BASE

# --- Database ---
DATABASE_URL=$DATABASE_URL
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
